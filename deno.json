{
	"nodeModulesDir": "auto",

	"tasks": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "deno run --allow-net --allow-env --allow-read=. deploy/server.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},

	"imports": {
		"@deno/svelte-adapter": "npm:@deno/svelte-adapter@^0.2.2",
		"@eslint/js": "npm:@eslint/js@^10.0.1",
		"@giscus/svelte": "npm:@giscus/svelte@^3.1.0",
		"@iconify-json/ic": "npm:@iconify-json/ic@^1.2.4",
		"@iconify-json/simple-icons": "npm:@iconify-json/simple-icons@^1.2.101",
		"@sveltejs/kit": "npm:@sveltejs/kit@^3.1.1",
		"@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^7.3.1",
		"@types/node": "npm:@types/node@^24.19.2",
		"eslint": "npm:eslint@^10.14.0",
		"eslint-config-prettier": "npm:eslint-config-prettier@^10.1.8",
		"eslint-plugin-svelte": "npm:eslint-plugin-svelte@^3.24.0",
		"globals": "npm:globals@^17.14.0",
		"prettier": "npm:prettier@^3.9.10",
		"prettier-plugin-svelte": "npm:prettier-plugin-svelte@^4.1.1",
		"svelte": "npm:svelte@^5.57.3",
		"svelte-check": "npm:svelte-check@^4.7.8",
		"typescript": "npm:typescript@^6.0.3",
		"typescript-eslint": "npm:typescript-eslint@^8.72.1",
		"unplugin-icons": "npm:unplugin-icons@^24.0.0",
		"vite": "npm:vite@^8.3.6",
		"yaml": "npm:yaml@^2.9.1"
	},

	"overrides": {
		"@icons-pack/svelte-simple-icons": {
			"@sveltejs/kit": "3.1.0"
		}
	}
}

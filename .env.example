# == Mailbox ==

# Mailbox Postgres. Host `db` resolves over the external `infra` network.
# Dedicated role/database (see mailbox/scripts/create-db.sql). URL-encode
# special chars in the password (# -> %23).
DATABASE_URL=postgres://mailbox:CHANGE_ME@db:5432/mailbox

RESEND_API_KEY=re_your_key_here
RESEND_WEBHOOK_SECRET=whsec_your_webhook_secret_here
SEND_FROM=you@yourdomain.com
MAIL_PORT=4040
DATA_DIR=./data
COOKIE_SECURE=true
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@yourdomain.com
# Shared PocketID issuer. Client id/secret are per-app: the mailbox's live
# here, music's are MUSIC_-prefixed below.
OIDC_ISSUER=https://doughmination.xyz
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://doughmination.tech/auth/callback

# Shared Redis (music namespaces its keys with `music:`). URL-encode special
# chars in the password (# -> %23).
REDIS_URL=redis://:PASSWORD@redis:6379/0

# == Music ==
# Hosted at doughmination.me. Reuses the shared OIDC_ISSUER + REDIS_URL above.
# Redirect is derived from MUSIC_APP_URL (+ /api/auth/callback); no session
# secret needed (sessions + the OIDC handshake both live in Redis).
MUSIC_APP_URL=https://doughmination.me
MUSIC_OIDC_CLIENT_ID=
MUSIC_OIDC_CLIENT_SECRET=
MUSIC_DATABASE_URL=postgres://music:CHANGE_ME@db:5432/music
MUSIC_PORT=4060
MUSIC_MEDIA_DIR=./data/media
MUSIC_MAX_UPLOAD_MB=200
# Comma-separated admins (PocketID username or email) who can edit/fix any song.
MUSIC_ADMINS=clove
MUSIC_POCKETID_API_KEY=API_KEY
MUSIC_LASTFM_API_KEY=
USIC_LASTFM_SHARED_SECRET=

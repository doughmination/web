# Copy to `.env`. In production it lives next to the build (see deploy/run).

# ---- Admin sign-in (Doughmination SSO) ---------------------------------------
# In the SSO admin, add a *confidential* application, group-locked to admins:
#   Redirect URI: https://doughmination.gay/admin/callback
#   (and http://localhost:5173/admin/callback for local dev)
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Optional, defaults to https://auth.doughmination.gay
# SSO_ISSUER=

# Signs the admin session cookie. At least 32 characters,
# e.g. `openssl rand -base64 48`.
SESSION_SECRET=

# ---- Guestbook ---------------------------------------------------------------
# Must match one of the API's GUESTBOOK_ADMIN_KEYS.
GUESTBOOK_ADMIN_KEY=

# Optional Cloudflare Turnstile site key. Leave blank if the API has no
# TURNSTILE_SECRET set, or every post will fail the captcha check.
PUBLIC_TURNSTILE_SITE_KEY=

# Music — LOCAL DEV example. In production these live in the monorepo root .env
# (dotenvx); see ../.env.example. Music reuses the shared OIDC_ISSUER + REDIS_URL
# and derives its OIDC redirect from MUSIC_APP_URL. No session secret needed.
# Copy to .env for local `bun run dev` against the local docker-compose.yml.

MUSIC_APP_URL=http://localhost:4060
MUSIC_PORT=4060

# Shared PocketID issuer + a DEDICATED music client (per-app id/secret).
# Register ${MUSIC_APP_URL}/api/auth/callback as the client's redirect URI.
OIDC_ISSUER=https://doughmination.xyz
MUSIC_OIDC_CLIENT_ID=your-client-id
MUSIC_OIDC_CLIENT_SECRET=your-client-secret

# Local dev services (see docker-compose.yml in this folder).
MUSIC_DATABASE_URL=postgres://music:music@localhost:5432/music
REDIS_URL=redis://localhost:6379/0

MUSIC_MEDIA_DIR=./data/media
MUSIC_MAX_UPLOAD_MB=200

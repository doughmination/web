# Music — LOCAL DEV example. In production these live (MUSIC_-prefixed) in the
# monorepo root .env managed by dotenvx; see ../.env.example.
# Copy to .env for local `bun run dev` against the local docker-compose.yml.

MUSIC_PORT=4060
MUSIC_APP_URL=http://localhost:4060

# Create a PocketID OIDC client; callback must match MUSIC_OIDC_REDIRECT_URI.
MUSIC_OIDC_ISSUER=https://doughmination.xyz
MUSIC_OIDC_CLIENT_ID=your-client-id
MUSIC_OIDC_CLIENT_SECRET=your-client-secret
MUSIC_OIDC_REDIRECT_URI=http://localhost:4060/api/auth/callback

# openssl rand -hex 32
MUSIC_SESSION_SECRET=change-me-to-a-long-random-hex-string

# Local dev services (see docker-compose.yml in this folder).
MUSIC_DATABASE_URL=postgres://music:music@localhost:5432/music
MUSIC_REDIS_URL=redis://localhost:6379/0

MUSIC_MEDIA_DIR=./data/media
MUSIC_MAX_UPLOAD_MB=200
